# Documentation only: Django does not load this file automatically.
# Defaults for local development; export variables in your shell or Railway.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
TORNEO_DEMO=0
TORNEO_DEV_LOCAL=0

# Production only: set DJANGO_DEBUG=False, a private random key (50+ chars),
# explicit real hosts and their HTTPS origins. Never commit actual credentials.
# Reference these PG variables from your Railway PostgreSQL service.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Railway supplies PORT automatically for Gunicorn. No DATABASE_URL is used.

# Optional real email delivery: configure your SMTP provider before sending.
# Local development retains the console mail backend.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=
# New non-avatar media. Production requires DJANGO_MEDIA_STORAGE=ionos.
# Leave the mapping blank until its REAL absolute SFTP root and public folder
# have been verified. Never infer them from the avatar URL or SFTP login cwd.
DJANGO_MEDIA_STORAGE=local
IONOS_MEDIA_REMOTE_ROOT=
IONOS_MEDIA_PUBLIC_BASE_URL=
# Existing avatar account: keep its directory and credentials unchanged.
IONOS_SFTP_USERNAME=
IONOS_SFTP_PASSWORD=

# Separate SFTP account for new non-avatar media; no fallback to avatars.
IONOS_MEDIA_SFTP_USERNAME=
IONOS_MEDIA_SFTP_PASSWORD=
